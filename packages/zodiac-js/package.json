{
  "name": "ets-zodiac",
  "version": "0.1.0",
  "description": "Cross-platform Zodiac SDK — Western & Chinese Zodiac data, calculations, icons, and localization",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zodiac",
    "astrology",
    "horoscope",
    "western-zodiac",
    "chinese-zodiac",
    "zodiac-sign",
    "zodiac-calculator",
    "localization",
    "typescript",
    "i18n"
  ],
  "author": "ETS-Zodiac-Sign Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ets-zodiac.git",
    "directory": "packages/zodiac-js"
  },
  "bugs": {
    "url": "https://github.com/your-org/ets-zodiac/issues"
  },
  "homepage": "https://github.com/your-org/ets-zodiac#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "rimraf": "^5.0.0"
  }
}
